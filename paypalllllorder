import "jsr:@supabase/functions-js/edge-runtime.d.ts";

const corsHeaders = {
  "Access-Control-Allow-Origin": "https://oraswiss.com",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
};

const PAYPAL_API = "https://api-m.paypal.com";

Deno.serve(async (req) => {
  // 1. Trajto kërkesat CORS
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders });
  }

  try {
    // 2. Lexo tekstin fillimisht për të shmangur gabimet e parse-imit
    const rawBody = await req.text();
    if (!rawBody) {
      return new Response(JSON.stringify({ error: "Empty request body" }), {
        status: 400,
        headers: { ...corsHeaders, "Content-Type": "application/json" }
      });
    }

    const body = JSON.parse(rawBody);
    const product_id = body.product_id;

    if (!product_id) {
      return new Response(JSON.stringify({ error: "Missing product_id" }), {
        status: 400,
        headers: { ...corsHeaders, "Content-Type": "application/json" }
      });
    }

    // ... pjesa tjetër e kodit tënd vazhdon këtu ...

    const supabaseUrl = Deno.env.get("SUPABASE_URL");
    const serviceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");

    const productResponse = await fetch(
      supabaseUrl + "/rest/v1/oras?id=eq." + product_id + "&select=*",
      {
        headers: {
          apikey: serviceKey,
          Authorization: "Bearer " + serviceKey
        }
      }
    );

    const products = await productResponse.json();

if (!products.length) {
  return new Response(
    JSON.stringify({
      error: "Product not found"
    }),
    {
      status: 404,
      headers: {
        ...corsHeaders,
        "Content-Type": "application/json"
      }
    }
  );
}


    const product = products[0];

    const clientId = Deno.env.get("PAYPAL_CLIENT_ID");
    const secret = Deno.env.get("PAYPAL_SECRET");
    
    console.log("CLIENT EXISTS:", !!clientId);
    console.log("SECRET EXISTS:", !!secret);

    const auth = btoa(clientId + ":" + secret);

    const tokenResponse = await fetch(
      PAYPAL_API + "/v1/oauth2/token",
      {
        method: "POST",
        headers: {
          Authorization: "Basic " + auth,
          "Content-Type": "application/x-www-form-urlencoded"
        },
        body: "grant_type=client_credentials"
      }
    );

    const token = await tokenResponse.json();

    console.log("PAYPAL TOKEN RESPONSE:", token);

    if (!token.access_token) {
      return Response.json(
        {
          error: "PayPal token failed",
          details: token
        },
        {
          status: 500,
          headers: corsHeaders
        }
      );
    }

const orderResponse = await fetch(
  PAYPAL_API + "/v2/checkout/orders",
  {
    method: "POST",
    headers: {
      Authorization: "Bearer " + token.access_token,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      intent: "CAPTURE",

      purchase_units: [
        {
          amount: {
            currency_code: "EUR",
            value: String(product.price)
          },
          description:
            product.brand + " " + product.model
        }
      ],

      application_context: {
        return_url: "https://oraswiss.com/payment-success.html",
        cancel_url: "https://oraswiss.com/payment-cancel.html"
      }
    })
  }
);

const order = await orderResponse.json();



    console.log("PAYPAL ORDER RESPONSE:", order);

    if (!order.links) {
      return Response.json(
        {
          error: "PayPal order failed",
          paypal_response: order
        },
        {
          status: 500,
          headers: corsHeaders
        }
      );
    }

    const approve = order.links.find(
      (link) => link.rel === "approve"
    );

return new Response(
  JSON.stringify({
    paypal_link: approve.href
  }),
  {
    status: 200,
    headers: {
      ...corsHeaders,
      "Content-Type": "application/json"
    }
  }
);


} catch (error) {

    console.error("PAYPAL ERROR:", error);

    return Response.json(
      {
        error: String(error)
      },
      {
        status: 500,
        headers: corsHeaders
      }
    );

  }
});
