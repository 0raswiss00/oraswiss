<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bracelets & Straps - Ora Swiss</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: #000; color: #fff; padding-bottom: 50px; }
.site-header { position: sticky; top: 0; z-index: 9999; background: #111; padding: 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; }
.site-title { font-weight: 700; color: #fff; text-decoration: none; font-size: 18px; }
.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 15px; }
@media (min-width: 768px) { .grid { grid-template-columns: repeat(4, 1fr); } }
.card { background: #111; padding: 15px; border-radius: 10px; border: 1px solid #333; cursor: pointer; }
.card img { width: 100%; height: 140px; object-fit: cover; display: block; border-radius: 8px; }
.card h3 { font-size: 16px; margin: 10px 0 5px 0; }
.price { color: #25D366; font-weight: bold; font-size: 15px; }
h1 { text-align: center; margin-top: 25px; font-size: 24px; }
.back-btn { background: #333; color: #fff; border: none; padding: 8px 15px; border-radius: 5px; cursor: pointer; text-decoration: none; font-size: 14px; }
</style>
</head>
<body>

<header class="site-header">
    <a href="index.html" class="site-title">ORA SWISS</a>
    <a href="index.html" class="back-btn">← Back to Home</a>
</header>

<h1>Bracelets & Straps Collection</h1>

<div id="bracelets-container" class="grid">Loading bracelets...</div>

<script>
const supabase = window.supabase.createClient(
    "https://gnwsrmelmeqduhhmfmoa.supabase.co", 
    "sb_publishable__AkK_Z7lhtkvukN6Fy1cAQ_KBTXIcY9"
);

async function loadAllBracelets() {
    const container = document.getElementById("bracelets-container");
    
    const { data, error } = await supabase
        .from("bracelets_straps")
        .select("*");

    if (error) {
        console.error("Gabim:", error);
        container.innerHTML = "Error loading bracelets.";
        return;
    }

    if (!data || data.length === 0) {
        container.innerHTML = "No bracelets found.";
        return;
    }

    container.innerHTML = data.map(item => {
        let imgUrl = "https://placeholder.co/600x400/222/fff?text=No+Image";
        let primaryImage = Array.isArray(item.image_url) ? item.image_url[0] : item.image_url;
        
        if (primaryImage && primaryImage !== 'null' && primaryImage !== '') {
            imgUrl = primaryImage.startsWith('http') ? primaryImage : "https://gnwsrmelmeqduhhmfmoa.supabase.co/storage/v1/object/public/or-images/" + primaryImage;
        }

        return `
            <div class="card" onclick="window.location.href='product-bracelet-strap.html?id=${item.id}'">
                <img src="${imgUrl}" alt="${item.brand || 'Strap'}">
                <h3>${item.brand || ""} ${item.model || ""}</h3>
                <div class="price">${item.price ? item.price + ' €' : 'Contact for price'}</div>
            </div>
        `;
    }).join('');
}

loadAllBracelets();
</script>

</body>
</html>
